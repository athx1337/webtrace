# =========================================================
# WEBTRACE OSINT ENGINE — ENVIRONMENT CONFIGURATION
# =========================================================

# --- AI Briefing Engine ---
# Google Gemini API Key (Used to generate 3-part structured executive security briefs)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Threat Intelligence Feeds ---
# AlienVault OTX API Key (Used for threat pulses and passive DNS lookups)
# Get a key at: https://otx.alienvault.com/
OTX_API_KEY=your_otx_api_key_here

# AbuseIPDB API Key (Used to query IP abuse scores and attack reports)
# Get a key at: https://www.abuseipdb.com/
ABUSEIPDB_KEY=your_abuseipdb_api_key_here

# GreyNoise Community API Key (Optional — used for scanner & benign internet noise checks)
# Get a key at: https://www.greynoise.io/
GREYNOISE_KEY=your_greynoise_api_key_here

# URLhaus API Key (Optional — used to check malicious URL payloads)
# Get a key at: https://urlhaus.abuse.ch/
URLHAUS_KEY=your_urlhaus_api_key_here

# ViewDNS API Key (Optional — used for IP historical resolution timelines)
# Get a key at: https://viewdns.info/
VIEWDNS_KEY=your_viewdns_api_key_here

# --- Frontend Configuration ---
# API Endpoint URL (In production: https://webtrace.phish-x.workers.dev)
VITE_API_URL=https://webtrace.phish-x.workers.dev
